\documentclass{hypertex}
\title{매개변수 슬라이더}
\parameter{\omega}{0.5}{3}{1}[step=0.1]
\parameter{\gamma}{0}{1}{0.2}

\begin{document}
% 매개변수 이름이 그리스 문자 명령과 같아도 된다. 계산식과 \showparam 안에서만 매개변수로 해석되고,
% 일반 수식 안에서는 그대로 그리스 문자다.
진동수 $\omega = \showparam{\omega}$, 감쇠 $\gamma = \showparam{\gamma}$.

\begin{tikzpicture}
  \draw[->] (0,0) -- (6.5,0) node[right] {$t$};
  \draw[thick, blue] plot[domain=0:6.28, samples=200]
        (\x, {exp(-\gamma*\x)*cos(\omega*\x r)});
\end{tikzpicture}

\begin{tikzpicture}
  \begin{axis}[xlabel={$t$}]
    \addplot[domain=0:10, samples=300] {ifthenelse(x < 5, sin(\omega*x r), 0)};
  \end{axis}
\end{tikzpicture}

선언되지 않은 매개변수: $\showparam{\kappa}$.
문법 오류 식:
\begin{tikzpicture}
  \draw plot[domain=0:1] (\x, {sin(\x r});
\end{tikzpicture}
허용되지 않는 함수:
\begin{tikzpicture}
  \draw plot[domain=0:1] (\x, {gamma(\x)});
\end{tikzpicture}
\end{document}
