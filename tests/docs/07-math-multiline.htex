\documentclass{hypertex}
\title{여러 줄 수식}

\begin{document}
\begin{align}
  (a+b)^2 &= a^2 + 2ab + b^2 \label{eq:sq} \\
  (a-b)^2 &= a^2 - 2ab + b^2 \nonumber \\
  a^2 - b^2 &= (a+b)(a-b) \label{eq:diff}
\end{align}

\begin{gather}
  x + y = 1 \\
  x - y = 0 \label{eq:g2}
\end{gather}

\begin{multline}\label{eq:long}
  f(x) = a_0 + a_1 x + a_2 x^2 + a_3 x^3 \\
  + a_4 x^4 + a_5 x^5
\end{multline}

\begin{align*}
  \text{번호 없음} &= 0
\end{align*}

식 \ref{eq:sq}, \ref{eq:diff}, \ref{eq:g2}, \ref{eq:long}.
\end{document}
